# Salin menjadi .env lalu GANTI semua nilai "change-me". Jangan commit .env.
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=warehouse
DB_PORT=5433

# Minimal 32 karakter acak, mis.: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
COOKIE_SECURE=false

# Password akun seed (username: operator dan supervisor)
SEED_OPERATOR_PASSWORD=change-me-operator
SEED_SUPERVISOR_PASSWORD=change-me-supervisor
SEED_DEMO_DATA=true

APP_PORT=3000
